rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read the list of groups
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberUserIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.memberUserIds;
    }

    // Members subcollection
    match /groups/{groupId}/members/{memberId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds;
      allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds; // Only existing members can add others
      allow write: if request.auth != null && request.auth.uid == memberId; // Users can only update their own membership status (e.g., accept invitation)
    }

    // Expenses subcollection
    match /groups/{groupId}/expenses/{expenseId} {
      allow read, create, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds;
    }

    // Recurring subcollection
    match /groups/{groupId}/recurring/{recurringId} {
      allow read, create, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUserIds;
    }

    // Settlements collection
    match /settlements/{settlementId} {
      allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUserIds;
      allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUserIds;
    }
  }
}